{
  "name": "own_web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "api:dev": "npm --prefix api run dev",
    "api:start": "npm --prefix api run start",
    "api:check": "npm --prefix api run check",
    "ai:index:backfill": "npm --prefix api run ai:index:backfill",
    "ai:index:post": "npm --prefix api run ai:index:post --",
    "ai:index:retry": "npm --prefix api run ai:index:retry",
    "ai:doctor": "npm --prefix api run ai:doctor",
    "ai:stream:doctor": "npm --prefix api run ai:stream:doctor",
    "ai:eval": "npm --prefix api run ai:eval",
    "ai:live:acceptance": "npm --prefix api run ai:live:acceptance",
    "ai:live:security": "npm --prefix api run ai:live:security",
    "ai:live:account": "npm --prefix api run ai:live:account",
    "test:lrc": "tsx scripts/lrc-smoke.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:ai-rag:unit": "vitest run --config vitest.config.ts tests/unit/ai-rag.test.ts",
    "test:ai-rag": "npm run test:ai-rag:unit && node tests/support/ai-qdrant-integration.cjs",
    "test:ai-agent": "vitest run --config vitest.config.ts tests/unit/ai-agent.test.ts tests/unit/ai-catalog.test.ts tests/unit/ai-conversation-store.test.ts",
    "test:ai-api": "vitest run --config vitest.config.ts tests/unit/ai-api.test.ts",
    "test:ai-ui": "node tests/support/run-ai-e2e.cjs",
    "test:ai-security": "vitest run --config vitest.config.ts tests/unit/ai-security.test.ts tests/unit/ai-api.test.ts tests/unit/ai-agent.test.ts",
    "test:ai": "npm run test:ai-rag && npm run test:ai-agent && npm run test:ai-api && npm run test:ai-security && npm run test:ai-ui",
    "test:ai-rag-integration": "node tests/support/ai-qdrant-integration.cjs",
    "test:api": "tsx tests/api/run-api-tests.ts && tsx tests/api/fourth-pass-report-api.ts && tsx tests/api/fifth-pass-related-privacy.ts && tsx tests/api/fifth-pass-personal-site.ts && tsx tests/api/fifth-pass-public-web.ts && tsx tests/api/sixth-pass-migration.ts && tsx tests/api/sixth-pass-time-db.ts",
    "test:e2e": "playwright test",
    "test:security": "tsx tests/security/security-regression.ts && tsx tests/security/fourth-pass-report-security.ts",
    "test:performance": "node tests/performance/lighthouse.cjs",
    "test:visual": "playwright test --config=playwright.visual.config.ts tests/e2e/visual.spec.ts",
    "test:all": "npm run typecheck && npm run build && npm run api:check && npm run test:lrc && npm run test:unit && npm run test:ai && npm run test:api && npm run test:e2e && npm run test:security && npm run test:visual && npm run test:performance && npm --prefix api run test:auth-account && npm --prefix api run test:study-access && npm --prefix api run test:media-access && npm --prefix api run test:blog-access"
  },
  "workspaces": [
    "api"
  ],
  "dependencies": {
    "@tiptap/core": "^3.30.5",
    "@tiptap/extension-image": "^3.30.5",
    "@tiptap/extension-link": "^3.30.5",
    "@tiptap/extension-table": "^3.30.5",
    "@tiptap/extension-table-cell": "^3.30.5",
    "@tiptap/extension-table-header": "^3.30.5",
    "@tiptap/extension-table-row": "^3.30.5",
    "@tiptap/markdown": "^3.30.5",
    "@tiptap/pm": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "@tiptap/vue-3": "^3.30.5",
    "axios": "^1.13.2",
    "dompurify": "^3.2.6",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.22",
    "marked": "^17.0.1",
    "vue": "^3.5.24",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "@playwright/test": "^1.55.0",
    "@axe-core/playwright": "^4.10.2",
    "lighthouse": "^12.8.2",
    "nodemon": "^3.1.11",
    "supertest": "^7.1.4",
    "tsx": "^4.23.12",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4",
    "vite": "^7.2.4",
    "vue-tsc": "^3.1.4"
  }
}
