# Server
NODE_ENV=development
PORT=3000

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace-with-your-local-password
DB_NAME=user_management

# Authentication
# Generate a long random value for real environments.
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_EXPIRES_IN=7d

# Comma-separated email addresses allowed to review community reports.
ADMIN_EMAILS=admin@example.com

# Frontend origin(s), comma-separated when needed.
CORS_ORIGIN=http://localhost:5173

# Frontend (leave empty when using the Vite dev proxy or same-origin deployment)
VITE_API_BASE_URL=
