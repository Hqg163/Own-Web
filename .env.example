# Server
NODE_ENV=development
PORT=3000

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace-with-your-local-password
DB_NAME=user_management
# Integration tests must use this isolated database, never the production/local data database.
TEST_DB_NAME=own_web_test
TEST_UPLOAD_ROOT=api/test-uploads

# Authentication
# Generate a long random value for real environments.
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_EXPIRES_IN=7d

# Comma-separated email addresses allowed to review community reports.
ADMIN_EMAILS=admin@example.com

# Frontend origin(s), comma-separated when needed.
CORS_ORIGIN=http://localhost:5173

# Public website identity. Use the stable database user id of the site owner;
# keep this separate from ADMIN_EMAILS, which only grants report-review access.
PUBLIC_SITE_URL=http://localhost:5173
SITE_OWNER_USER_ID=

# Frontend (leave empty when using the Vite dev proxy or same-origin deployment)
VITE_API_BASE_URL=

# AI Agent / RAG. Keep disabled until Qdrant and provider credentials are configured.
AI_ENABLED=false
AI_PROVIDER_MODE=mock
AI_LIVE_TESTS=false
AI_DEFAULT_MODEL=qwen-fast
DASHSCOPE_API_KEY=
QWEN_BASE_URL=
# Optional non-standard endpoint overrides. Normally leave these empty and
# derive all three endpoints from QWEN_BASE_URL.
QWEN_CHAT_BASE_URL=
QWEN_EMBEDDING_BASE_URL=
QWEN_RERANK_BASE_URL=
QWEN_CHAT_MODEL=qwen3.8-flash
AI_EMBEDDING_MODEL=text-embedding-v4
AI_EMBEDDING_DIM=1024
AI_RERANK_MODEL=qwen3-rerank
AI_ENABLE_RERANK=true
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
AI_QDRANT_COLLECTION=own_web_ai_content_v1
AI_MAX_TOOL_ROUNDS=3
AI_MAX_INPUT_CHARS=8000
AI_MAX_SELECTED_TEXT_CHARS=4000
AI_MAX_OUTPUT_TOKENS=1200
AI_RECENT_MESSAGE_LIMIT=8
AI_MAX_CONTEXT_CHARS=12000
AI_MAX_TOOL_RESULT_CHARS=6000
AI_IP_WINDOW_LIMIT=20
AI_IP_WINDOW_MS=3600000
AI_GUEST_DAILY_LIMIT=5
AI_USER_DAILY_LIMIT=50
AI_MAX_CONCURRENT_PER_USER=2
AI_GLOBAL_DAILY_REQUEST_LIMIT=1000
AI_GLOBAL_DAILY_TOKEN_LIMIT=500000
AI_CACHE_MAX_ENTRIES=500
AI_CACHE_TTL_MS=300000
AI_CONFIDENCE_HIGH=0.55
AI_CONFIDENCE_MEDIUM=0.25
AI_CONFIDENCE_MIN_GAP=0.05
AI_CONFIDENCE_MIN_EVIDENCE_SCORE=0.4
AI_CONFIDENCE_MIN_LEXICAL_TERMS=1
AI_CONFIDENCE_HIGH_COVERAGE=0.5
AI_CONFIDENCE_MEDIUM_COVERAGE=0.25
